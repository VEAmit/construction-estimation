<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="PdfPig" Version="0.1.9" />
    <PackageReference Include="PDFtoImage" Version="4.0.3" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.8.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Syncfusion.EJ2.PdfViewer.AspNet.Core" Version="29.2.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ConstructionEstimation.Core\ConstructionEstimation.Core.csproj" />
    <ProjectReference Include="..\ConstructionEstimation.Infrastructure\ConstructionEstimation.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Not auto-included by the SDK (unlike wwwroot); without this, dotnet publish silently
       drops tessdata/eng.traineddata from the deploy output, breaking OCR extraction on any
       machine running the published build (e.g. IIS) even though dotnet run in dev works fine,
       since dev's content root is the project source folder where tessdata already lives. -->
  <ItemGroup>
    <Content Include="tessdata\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- Always place the current React production bundle in an IIS publish output.
       This prevents a publish from silently serving the older bundle checked into
       wwwroot (which did not submit the key during first-time configuration). -->
  <PropertyGroup>
    <FrontendProjectDirectory>$(MSBuildProjectDirectory)\..\..\frontend</FrontendProjectDirectory>
  </PropertyGroup>

  <Target Name="BuildAndCopyFrontendForPublish"
          AfterTargets="Publish"
          Condition="Exists('$(FrontendProjectDirectory)\package.json')">
    <Exec WorkingDirectory="$(FrontendProjectDirectory)"
          Command="npm.cmd run build" />
    <ItemGroup>
      <FrontendPublishFiles Include="$(FrontendProjectDirectory)\dist\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(FrontendPublishFiles)"
          DestinationFiles="@(FrontendPublishFiles->'$(PublishDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
