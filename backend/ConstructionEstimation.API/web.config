<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS deployment settings. The <aspNetCore> handler element is injected by the
  SDK during `dotnet publish`, so it is deliberately not written here.

  WebDAV: IIS enables the WebDAV module by default, and it intercepts PUT and
  DELETE before ASP.NET Core ever sees them, answering 405 Method Not Allowed.
  That is why measurement auto-save (PUT /api/takeoffitems/{id}) works under
  Kestrel locally but fails once deployed to IIS. Removing the module and its
  handler hands those verbs back to the application.

  maxAllowedContentLength: DrawingsController allows 100 MB uploads
  ([RequestSizeLimit(100_000_000)]), but IIS caps request bodies at ~28.6 MB by
  default and rejects larger PDFs before the app runs. Raised to match.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <modules>
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
      </handlers>
      <security>
        <requestFiltering>
          <!-- 200 MB. Must stay >= Uploads:MaxBytes in Program.cs, otherwise
               IIS rejects first with 404.13 and the application-side limit
               never applies. -->
          <requestLimits maxAllowedContentLength="209715200" />
          <verbs allowUnlisted="true">
            <remove verb="PUT" />
            <add verb="PUT" allowed="true" />
            <remove verb="DELETE" />
            <add verb="DELETE" allowed="true" />
            <remove verb="PATCH" />
            <add verb="PATCH" allowed="true" />
          </verbs>
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
